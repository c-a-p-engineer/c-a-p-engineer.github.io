---
import { render } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles } from '../lib';

const taxonomySlug = (value: string) => value.trim().toLowerCase().replace(/\s+/g, '-');
const resolvePublicPath = (value?: string) => {
  if (!value) return undefined;
  if (/^https?:\/\//.test(value) || value.startsWith('/')) return value;
  return `/${value}`;
};

export async function getStaticPaths() {
  const entries = await articles();
  const seen = new Set<string>();

  return entries.map(entry => {
    if (seen.has(entry.data.legacySlug)) {
      throw new Error(`Duplicate legacy slug: ${entry.data.legacySlug}`);
    }
    seen.add(entry.data.legacySlug);
    return { params: { slug: entry.data.legacySlug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const publishedTime = entry.data.date.toISOString();
const modifiedTime = (entry.data.updated ?? entry.data.date).toISOString();
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const articleUrl = new URL(`/${entry.data.legacySlug}/`, siteOrigin).href;
const markdownPath = `/${entry.data.legacySlug}.md`;
const imagePath = resolvePublicPath(entry.data.image);
const imageUrl = imagePath ? new URL(imagePath, siteOrigin).href : undefined;

const allArticles = await articles();
const relatedArticles = allArticles
  .filter(candidate => candidate.id !== entry.id)
  .map(candidate => {
    const sharedTags = candidate.data.tags.filter(tag => entry.data.tags.includes(tag)).length;
    const sharedCategories = candidate.data.categories.filter(category => entry.data.categories.includes(category)).length;
    return { article: candidate, score: sharedTags * 4 + sharedCategories * 2 };
  })
  .filter(candidate => candidate.score > 0)
  .sort((a, b) => b.score - a.score || b.article.data.date.valueOf() - a.article.data.date.valueOf())
  .slice(0, 3)
  .map(candidate => candidate.article);

const author = {
  '@type': 'Person',
  name: 'Copy & Paste Engineer',
  url: new URL('/about/', siteOrigin).href,
  sameAs: [
    'https://github.com/c-a-p-engineer',
    'https://x.com/c_a_p_engineer',
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  inLanguage: 'ja-JP',
  author,
  publisher: author,
  ...(entry.data.tags.length > 0 ? { keywords: entry.data.tags.join(', ') } : {}),
  ...(entry.data.categories.length > 0 ? { articleSection: entry.data.categories } : {}),
  ...(imageUrl ? { image: [imageUrl] } : {}),
};
---
<BaseLayout
  title={`${entry.data.title} | Copy & Paste Engineer`}
  description={entry.data.description}
  image={imagePath}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  markdownAlternate={markdownPath}
  tags={entry.data.tags}
  jsonLd={jsonLd}
>
  <article class="article">
    <p class="meta">
      <time datetime={publishedTime}>{entry.data.date.toLocaleDateString('ja-JP')}</time>
    </p>
    <h1>{entry.data.title}</h1>
    {(entry.data.categories.length > 0 || entry.data.tags.length > 0) && (
      <p aria-label="記事の分類">
        {entry.data.categories.map(category => (
          <a class="tag" href={`/categories/${taxonomySlug(category)}/`}>{category}</a>
        ))}
        {entry.data.tags.map(tag => (
          <a class="tag" href={`/tags/${taxonomySlug(tag)}/`}>{tag}</a>
        ))}
      </p>
    )}
    <Content />
  </article>

  <section class="article-followup" aria-labelledby="related-articles-title">
    <div class="followup-heading">
      <div>
        <p class="eyebrow">Keep reading</p>
        <h2 id="related-articles-title">関連記事</h2>
      </div>
      <a href="/search/">記事を検索 →</a>
    </div>

    {relatedArticles.length > 0 ? (
      <div class="related-grid">
        {relatedArticles.map(article => <ArticleCard article={article} heading="h3" />)}
      </div>
    ) : (
      <p class="related-empty">関連する記事がまだありません。キーワード検索から過去の記事を探せます。</p>
    )}
  </section>
</BaseLayout>

<style>
  .article-followup{max-width:960px;margin:-2rem auto 6rem;padding-top:2.2rem;border-top:1px solid var(--line-strong)}
  .followup-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:1.2rem}
  .followup-heading .eyebrow{margin-bottom:.3rem}
  .followup-heading h2{margin:0;font-size:clamp(1.55rem,3vw,2rem);letter-spacing:-.03em}
  .followup-heading > a{flex:0 0 auto;color:#4640bd;font-size:.9rem;font-weight:750}
  .followup-heading > a:hover{text-decoration:underline;text-underline-offset:.22em}
  .related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  .related-empty{margin:0;color:#667085}
  @media(max-width:840px){.related-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:640px){
    .article-followup{margin-top:-3rem}
    .followup-heading{align-items:flex-start;flex-direction:column}
    .related-grid{grid-template-columns:1fr}
  }
</style>
