---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { articles, techBookFestOgp } from '../lib';

const allArticles = await articles();
const [projectEntries, bookEntries] = await Promise.all([
  getCollection('projects'),
  getCollection('books'),
]);
const projects = projectEntries.sort((a, b) => a.data.order - b.data.order);
const books = bookEntries.sort((a, b) => a.data.order - b.data.order);
const recent = allArticles.slice(0, 5);
const isExternal = (href?: string) => Boolean(href?.startsWith('http://') || href?.startsWith('https://'));
const taxonomySlug = (value: string) => value.trim().toLowerCase().replace(/\s+/g, '-');
const topicCounts = new Map<string, number>();
for (const article of allArticles) {
  for (const category of article.data.categories) {
    topicCounts.set(category, (topicCounts.get(category) || 0) + 1);
  }
}
const topTopics = [...topicCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ja'))
  .slice(0, 9);
const description = 'こぴぺたん（Copy & Paste Engineer）のほ～むぺ～じ。平成の個人サイト風に、技術記事・個人開発・AI・技術書を紹介します。';
const siteUrl = new URL('/', Astro.site ?? Astro.url.origin).href;
const personId = new URL('/about/#author', Astro.site ?? Astro.url.origin).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': siteUrl + '#website',
      name: 'Copy & Paste Engineer',
      alternateName: 'こぴぺたんのほ～むぺ～じ',
      url: siteUrl,
      description,
      inLanguage: 'ja-JP',
      publisher: { '@id': personId },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: new URL('/search/?q={search_term_string}', Astro.site ?? Astro.url.origin).href,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Blog',
      '@id': siteUrl + '#blog',
      name: 'Copy & Paste Engineer',
      url: siteUrl,
      description,
      inLanguage: 'ja-JP',
      author: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Copy & Paste Engineer',
      alternateName: ['c-a-p-engineer', 'こぴぺたん'],
      url: new URL('/about/', Astro.site ?? Astro.url.origin).href,
      sameAs: ['https://github.com/c-a-p-engineer', 'https://x.com/c_a_p_engineer'],
    },
  ],
};
---
<BaseLayout title="こぴぺたんのほ～むぺ～じ | Copy & Paste Engineer" description={description} jsonLd={jsonLd} theme="retro">
  <div class="retro-page">
    <div class="retro-topline"><span>★　WELCOME TO MY HOMEPAGE　★</span><span>ネットの片隅で今日もなにか作っています。</span></div>

    <header class="retro-masthead">
      <div class="masthead-stickers" aria-hidden="true"><span>★</span><span>✦</span><span>★</span></div>
      <p class="retro-kicker">ようこそ！　いらっしゃいませ～！</p>
      <h1><span class="retro-name">こぴぺたんの</span><span class="retro-home">ほ～むぺ～じ</span></h1>
      <p class="retro-subtitle">★ AI × プログラミング × 個人開発 × 技術書 ★</p>
      <div class="retro-welcome-strip"><span class="sparkle" aria-hidden="true">✧</span> キリ番踏んだら心の中で報告してね！ <span class="sparkle" aria-hidden="true">✧</span></div>
    </header>

    <div class="retro-marquee" aria-label="サイトからのお知らせ">
      <span>★★★　祝・ご訪問！　ここは「こぴぺたん」の個人サイトです。リンクフリー／無断リンク大歓迎！　BGMは鳴りません。安心してお楽しみください。　★★★</span>
    </div>

    <nav class="retro-local-nav" aria-label="このページの目次">
      <a href="#welcome">はじめに</a>
      <a href="#diary">更新履歴</a>
      <a href="#program">技術の部屋</a>
      <a href="#works">作品置き場</a>
      <a href="#bookshelf">ほんだな</a>
      <a href="#links">リンク集</a>
    </nav>

    <div class="retro-columns">
      <aside class="retro-left" aria-label="プロフィールとメニュー">
        <section class="retro-panel counter-box">
          <h2>☆ あくせすかうんた ☆</h2>
          <p class="counter-label">あなたは</p>
          <div class="counter-digits" aria-label="アクセスカウンターは停止中">??????</div>
          <p class="counter-label">人目のお客様です</p>
          <p class="counter-note">※ カウンター故障中。気持ちは100万HIT。</p>
        </section>

        <section class="retro-panel side-menu">
          <h2>■ MENU ■</h2>
          <a href="/">★ TOP</a>
          <a href="/about/">★ 管理人について</a>
          <a href="/articles/">★ 技術日記</a>
          <a href="/search/">★ 記事をさがす</a>
          <a href="/projects/">★ おへや・制作物</a>
          <a href="/books/">★ 自費出版・書籍</a>
          <a href="/rss.xml">★ RSS購読</a>
          <a href="https://github.com/c-a-p-engineer" target="_blank" rel="noopener noreferrer">★ GitHub</a>
        </section>

        <section class="retro-panel profile-box">
          <h2>管理人ぷろふぃーる</h2>
          <p class="profile-avatar" aria-hidden="true">（ ´∀｀）<span>ノ</span></p>
          <p><strong>HN：</strong>こぴぺたん</p>
          <p><strong>属性：</strong>ソフトウェアエンジニア</p>
          <p><strong>すき：</strong>コード・AI・ものづくり・古き良きインターネット</p>
          <a href="/about/">≫ もっと詳しく</a>
        </section>

        <div class="retro-banners" aria-label="懐かしのミニバナー">
          <span class="mini-banner bn-purple">BEST VIEWED<br /><b>1024×768</b></span>
          <span class="mini-banner bn-blue">HTML &amp; CSS<br /><b>LOVE IT!</b></span>
          <span class="mini-banner bn-green">NO BGM<br /><b>PEACEFUL</b></span>
          <span class="mini-banner bn-orange">LINK<br /><b>FREE!</b></span>
        </div>
      </aside>

      <div class="retro-main">
        <section id="welcome" class="retro-section greeting">
          <h2><span>★</span> はじめに <span>★</span></h2>
          <p class="greeting-big">ようこそ、こぴぺたんのほ～むぺ～じへ！</p>
          <p>ここは管理人「こぴぺたん」が、プログラミング・生成AI・自作ツール・書いた本などを好き勝手に並べているインターネットの片隅です。</p>
          <p>見た目は平成、動いている技術は令和。実装したこと、失敗したこと、気付いたことを残していきます。初めての方も常連さんも、どうぞごゆっくり。</p>
          <p class="pink-note">※ 掲載記事は今も読めます。古いURLもそのままです。</p>
        </section>

        <section class="retro-section pickup">
          <h2><span>☆</span> 管理人からのお知らせ <span>☆</span></h2>
          <div class="pickup-inner">
            <div class="new-stamp" aria-hidden="true">NEW!</div>
            <div>
              <p class="pickup-label">商業出版のおしらせ</p>
              <h3>『実践AI駆動開発』を出版しました！</h3>
              <p>AIと開発するための設計・レビュー・運用の考え方をまとめた一冊です。</p>
              <a href="https://nextpublishing.jp/book/19913.html" target="_blank" rel="noopener noreferrer">≫ 出版社の書籍ページを見る</a>
              <a href="https://news.nextpublishing.jp/news/detail/1642/" target="_blank" rel="noopener noreferrer">≫ 刊行ニュース</a>
            </div>
          </div>
        </section>

        <section id="diary" class="retro-section">
          <h2><span>★</span> 更新りれき <span>★</span></h2>
          <p class="retro-small">技術記事の新着を自動表示しています。</p>
          <ul class="news-list">
            {recent.map(article => (
              <li>
                <time datetime={article.data.date.toISOString()}>{article.data.date.toLocaleDateString('ja-JP')}</time>
                <a href={'/' + article.data.legacySlug + '/'}>{article.data.title}</a>
                <span class="news-new">NEW</span>
              </li>
            ))}
          </ul>
          <p class="more-link"><a href="/articles/">≫ 技術日記を全部読む</a></p>
        </section>

        <section id="program" class="retro-section">
          <h2><span>★</span> 技術の部屋 <span>★</span></h2>
          <p>気になるジャンルをクリックしてね。昔のホームページ風だけど、中身はちゃんとエンジニアリング。</p>
          <div class="topic-board">
            {topTopics.map(([topic, count]) => (
              <a href={'/categories/' + taxonomySlug(topic) + '/'}><span class="topic-icon" aria-hidden="true">◆</span> {topic} <small>({count})</small></a>
            ))}
            <a class="topic-search" href="/search/">⌕ 記事を検索する</a>
          </div>
        </section>

        <section id="works" class="retro-section">
          <h2><span>★</span> 作品おきば <span>★</span></h2>
          <p>自分で作ったアプリやOSS。気になるものはご自由にどうぞ。</p>
          <div class="retro-work-grid">
            {projects.filter(project => project.data.featured).slice(0, 6).map(project => {
              const external = isExternal(project.data.href);
              return (
                <a class="work-item" href={project.data.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
                  <span class="folder-icon" aria-hidden="true">▣</span>
                  <strong>{project.data.title}</strong>
                  <small>{project.data.description}</small>
                </a>
              );
            })}
          </div>
          <p class="more-link"><a href="/projects/">≫ 作品ぜんぶ見る</a></p>
        </section>

        <section id="bookshelf" class="retro-section">
          <h2><span>★</span> こぴぺたんの本だな <span>★</span></h2>
          <p>技術書典や商業出版で出した本たちを並べています。</p>
          <div class="retro-books">
            {books.slice(0, 5).map(book => {
              const href = book.data.href || '/books/';
              const external = isExternal(href);
              const cover = book.data.coverImage || (book.data.status ? undefined : techBookFestOgp(href));
              return (
                <a href={href} class="retro-book" target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
                  <span class="retro-book-cover">
                    {cover ? <img src={cover} alt="" loading="lazy" decoding="async" /> : <span class="no-cover" aria-hidden="true">技<br />術<br />書</span>}
                  </span>
                  <strong>{book.data.title}</strong>
                  <small>{book.data.event || 'BOOK'}</small>
                </a>
              );
            })}
          </div>
          <p class="more-link"><a href="/books/">≫ 本だなを全部見る</a></p>
        </section>

        <section id="links" class="retro-section">
          <h2><span>★</span> リンク集 <span>★</span></h2>
          <p class="retro-small">当サイトはリンクフリーです。直リンクOK！ 報告は不要です。</p>
          <div class="retro-link-list">
            <a href="https://github.com/c-a-p-engineer" target="_blank" rel="noopener noreferrer">[ GitHub ] ソースコードの置き場</a>
            <a href="https://x.com/c_a_p_engineer" target="_blank" rel="noopener noreferrer">[ X ] こぴぺたんの近況</a>
            <a href="https://techbookfest.org/organization/5zdy9h5eA5kDzByP9rserV" target="_blank" rel="noopener noreferrer">[ 技術書典 ] こぴみずむの本</a>
            <a href="/rss.xml">[ RSS ] 更新を追いかける</a>
          </div>
        </section>
      </div>

      <aside class="retro-right" aria-label="おまけとお知らせ">
        <section class="retro-panel">
          <h2>★ ごあんない ★</h2>
          <p class="ascii-flower" aria-hidden="true">☆ﾟ.*･｡ﾟ</p>
          <p>このサイトは、古き良き「個人ほむぺ」を愛する方向けに装飾をたっぷり盛っています。</p>
          <p class="side-emphasis">スマホからも見られるよ！</p>
        </section>

        <section class="retro-panel">
          <h2>工事中...</h2>
          <div class="construction" aria-hidden="true">＼ 只今改装中 ／</div>
          <p>掲示板・チャット・同盟バナーは準備中です。</p>
          <p>そのうち何か増える……かもしれない。</p>
        </section>

        <section class="retro-panel secret-panel">
          <h2>ひみつのへや</h2>
          <details>
            <summary>？？？ 開けてみる ？？？</summary>
            <p>ここまで見つけたあなたは立派なネット老人会員です。</p>
            <p>隠しページを作るのが楽しかったあの頃を忘れない。</p>
          </details>
        </section>

        <section class="retro-panel net-etiquette">
          <h2>おやくそく</h2>
          <p>・リンクフリー</p>
          <p>・転載するときは出典を添えてね</p>
          <p>・BGM自動再生なし</p>
          <p>・怪しいポップアップなし</p>
          <p>・ブラウザを閉じても呪われません</p>
        </section>
      </aside>
    </div>

    <div class="retro-finale">
      <p>★ 最後まで見てくれてありがとう ★</p>
      <p>また遊びにきてね！ (・∀・)ノ</p>
      <div class="badge-row" aria-hidden="true"><span>LINK FREE</span><span>MADE WITH ♥ &amp; CODE</span><span>平成魂 / 令和技術</span></div>
      <a href="#top" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;">▲ PAGE TOP ▲</a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  body.retro-mode {
    --accent: #b30091;
    --line: #ccabc9;
    --line-strong: #a885aa;
    --text: #30204e;
    --muted: #67557c;
    --accent-soft: #fff0fa;
    background-color: #10134e;
    background-image:
      radial-gradient(circle at 12px 12px, #eabaff 1px, transparent 2px),
      radial-gradient(circle at 38px 41px, #6a9cfa 1px, transparent 2px),
      linear-gradient(135deg, #151a58, #242064 52%, #16174d);
    background-size: 74px 74px, 103px 103px, auto;
    color: #30204e;
    font-family: "MS PGothic", "Hiragino Kaku Gothic ProN", "Yu Gothic", system-ui, sans-serif;
  }
  body.retro-mode a:focus-visible,
  body.retro-mode button:focus-visible,
  body.retro-mode summary:focus-visible { outline: 3px solid #ec008c; outline-offset: 3px; }
  body.retro-mode .site-header {
    position: static;
    max-width: 1020px;
    margin: 16px auto 0;
    padding: 10px 15px;
    border: 4px ridge #f6c5fa;
    background: #fff4fa;
    backdrop-filter: none;
    box-shadow: 5px 5px 0 #090c33;
  }
  body.retro-mode .brand { color: #87046c; font-family: Georgia, serif; }
  body.retro-mode .brand::before { content: "★"; background: #b30091; border-radius: 0; color: #fff; }
  body.retro-mode .site-header nav a { color: #640e72; border-radius: 0; text-decoration: underline; }
  body.retro-mode .site-header nav a:hover { color: #d7008a; background: #ffe2f7; }
  body.retro-mode main { max-width: 1040px; min-height: 0; margin: 0 auto; padding: 0 10px; }
  body.retro-mode > footer {
    max-width: 1020px;
    margin: 0 auto 18px;
    padding: 15px;
    border: 4px ridge #f6c5fa;
    background: #fff4fa;
    color: #563960;
  }
  @media (max-width: 820px) {
    body.retro-mode .site-header { margin-top: 8px; }
    body.retro-mode .site-header nav { overflow-x: auto; }
  }
</style>

<style>
  .retro-page { margin: 10px 0 12px; border: 6px ridge #ffa2e1; background: #fff9ec; box-shadow: 7px 9px 0 #080a38; font-size: .95rem; line-height: 1.7; }
  .retro-page a { color: #173da5; text-decoration: underline; text-underline-offset: 2px; }
  .retro-page a:hover { color: #dc0b82; }
  .retro-topline { display: flex; justify-content: space-between; gap: 10px; padding: 4px 12px; background: #30106c; color: #fff7b5; font-size: .74rem; letter-spacing: .03em; }
  .retro-masthead { position: relative; overflow: hidden; padding: 32px 15px 22px; border-bottom: 5px double #eb68b3; background: repeating-linear-gradient(135deg,#ffe6f5 0 13px,#fff2fb 13px 26px); text-align: center; }
  .masthead-stickers { display: flex; justify-content: space-around; position: absolute; inset: 0; align-items: center; color: #ed4ba0; font-size: clamp(2rem,7vw,5rem); opacity: .3; pointer-events: none; }
  .retro-kicker { position: relative; margin: 0 0 8px; color: #80177b; font-weight: 800; letter-spacing: .08em; }
  .retro-masthead h1 { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0; max-width: none; margin: 0; line-height: 1.1; letter-spacing: .035em; font-weight: 900; text-shadow: 3px 3px 0 #fff, 6px 6px 0 #ffc2e5; }
  .retro-name { color: #5c2593; font-size: clamp(1.65rem, 4.8vw, 3.2rem); }
  .retro-home { color: #e6007d; font-size: clamp(2.1rem, 7vw, 5rem); }
  .retro-subtitle { position: relative; margin: 14px 0 12px; font-weight: 800; color: #453088; }
  .retro-welcome-strip { display: inline-block; position: relative; max-width: 100%; padding: 3px 15px; border: 2px dashed #e1389b; background: #fffdf2; color: #8a2261; font-size: .86rem; }
  .sparkle { color: #f33c84; animation: pulse 1.5s steps(2,end) infinite; }
  .retro-marquee { overflow: hidden; border-top: 2px solid #fff; border-bottom: 2px solid #6a348b; background: #fff3b8; color: #a40070; font-weight: 800; font-size: .8rem; white-space: nowrap; }
  .retro-marquee span { display: inline-block; padding: 5px 0; padding-left: 100%; animation: scroll-left 26s linear infinite; }
  .retro-marquee:hover span { animation-play-state: paused; }
  .retro-local-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 5px; padding: 10px; border-bottom: 4px double #ad5aa4; background: #ebd8ff; }
  .retro-local-nav a { display: inline-block; min-width: 94px; padding: 5px 9px; border: 2px outset #fff; background: #fff1fa; color: #7c1767; text-align: center; font-weight: 800; text-decoration: none; box-shadow: 2px 2px 0 #b58ac1; }
  .retro-local-nav a:hover { border-style: inset; background: #ffdbef; color: #8d115c; }
  .retro-columns { display: grid; grid-template-columns: 175px minmax(0,1fr) 170px; align-items: start; gap: 10px; padding: 12px 10px; }
  .retro-left, .retro-right { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .retro-panel { padding: 9px; border: 3px double #c371a8; background: #fff4fa; overflow-wrap: anywhere; }
  .retro-panel h2 { margin: -9px -9px 10px; padding: 4px 5px; background: #a8449c; color: #fff; font-size: .82rem; text-align: center; letter-spacing: .04em; }
  .retro-panel p { margin: 7px 0; font-size: .8rem; }
  .counter-box { text-align: center; background: #fffde8; }
  .counter-label { margin: 2px 0!important; }
  .counter-digits { display: inline-block; padding: 2px 8px; border: 3px inset #ab8c95; background: #151421; color: #e6fa46; font: 800 1.25rem/1.6 "Courier New", monospace; letter-spacing: .11em; }
  .counter-note { color: #72536a; font-size: .68rem!important; }
  .side-menu a { display: block; padding: 5px 4px; border-bottom: 1px dotted #d8b8d2; color: #5f1689; font-size: .82rem; font-weight: 700; }
  .side-menu a:hover { background: #ffe1f4; }
  .profile-avatar { color: #711a84; font: 900 1.55rem/1.5 monospace!important; text-align: center; white-space: nowrap; }
  .profile-avatar span { margin-left: 3px; }
  .profile-box strong { color: #9a1483; }
  .profile-box > a { display: block; padding-top: 5px; text-align: right; font-size: .78rem; }
  .retro-banners { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
  .mini-banner { display: grid; place-items: center; min-height: 42px; padding: 2px; border: 2px outset white; color: white; font: 700 .55rem/1.15 "Courier New",monospace; text-align: center; }
  .mini-banner b { font-size: .65rem; }
  .bn-purple { background: linear-gradient(120deg,#36145d,#a315be); }
  .bn-blue { background: linear-gradient(120deg,#063b7a,#2484d4); }
  .bn-green { background: linear-gradient(120deg,#14533b,#379363); }
  .bn-orange { background: linear-gradient(120deg,#ae3202,#f59a2f); }
  .retro-main { min-width: 0; }
  .retro-section { margin: 0 0 13px; padding: 12px 14px 15px; border: 3px double #a56ca0; background: #fffdfa; }
  .retro-section h2 { margin: -12px -14px 12px; padding: 7px 12px; border-bottom: 2px solid #d96eac; background: linear-gradient(90deg,#fee1ef,#eee1ff); color: #8d0e7c; font-size: 1.14rem; letter-spacing: .05em; }
  .retro-section h2 span { color: #d31499; }
  .retro-section p { margin: 9px 0; }
  .greeting { background: #fffef2; }
  .greeting-big { color: #d00675; font-weight: 800; font-size: 1.04rem; text-align: center; }
  .pink-note { padding: 6px 8px; border-left: 4px solid #e93e97; background: #fff0f8; font-size: .82rem; }
