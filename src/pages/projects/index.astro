---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getCollection } from 'astro:content'; const projects=await getCollection('projects');
---
<BaseLayout title="Projects | Copy & Paste Engineer"><section class="section"><p class="eyebrow">Projects</p><h1>つくったもの</h1><div class="grid">{projects.map(p=><a class="card" href={p.data.href}><h2>{p.data.title}</h2><p>{p.data.description}</p>{p.data.tags.map(t=><span class="tag">{t}</span>)}</a>)}</div></section></BaseLayout>
