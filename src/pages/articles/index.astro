---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles } from '../../lib';

const all = await articles();

const countTerms = (values: string[][]) => {
  const counts = new Map<string, number>();
  for (const list of values) {
    for (const value of list) counts.set(value, (counts.get(value) || 0) + 1);
  }
  return [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ja'));
};

const tags = countTerms(all.map(article => article.data.tags));
const categories = countTerms(all.map(article => article.data.categories));
const visibleTags = tags.slice(0, 16);
const hiddenTags = tags.slice(16);
const visibleCategories = categories.slice(0, 12);
const hiddenCategories = categories.slice(12);
---
<BaseLayout title="Articles | Copy & Paste Engineer">
  <section class="section article-archive">
    <p class="eyebrow">Articles</p>
    <h1>技術記事</h1>
    <div class="archive-intro">
      <p>{all.length}本の記録。サムネイルからざっと眺めて、必要ならタグやカテゴリで絞り込めます。</p>
      <p class="filter-status" aria-live="polite">{all.length}本を表示中</p>
    </div>

    {(tags.length > 0 || categories.length > 0) && (
      <details class="taxonomy-panel">
        <summary>タグ・カテゴリから絞り込む</summary>
        <div class="taxonomy-content">
          {tags.length > 0 && (
            <div class="taxonomy-group">
              <p class="taxonomy-title">タグ</p>
              <div class="taxonomy-chips">
                {visibleTags.map(([name, count]) => (
                  <button type="button" data-filter-kind="tag" data-filter-value={name}>{name}<span>{count}</span></button>
                ))}
              </div>
              {hiddenTags.length > 0 && (
                <details class="taxonomy-more">
                  <summary>ほか{hiddenTags.length}件を表示</summary>
                  <div class="taxonomy-chips taxonomy-chips-more">
                    {hiddenTags.map(([name, count]) => (
                      <button type="button" data-filter-kind="tag" data-filter-value={name}>{name}<span>{count}</span></button>
                    ))}
                  </div>
                </details>
              )}
            </div>
          )}

          {categories.length > 0 && (
            <div class="taxonomy-group">
              <p class="taxonomy-title">カテゴリ</p>
              <div class="taxonomy-chips">
                {visibleCategories.map(([name, count]) => (
                  <button type="button" data-filter-kind="category" data-filter-value={name}>{name}<span>{count}</span></button>
                ))}
              </div>
              {hiddenCategories.length > 0 && (
                <details class="taxonomy-more">
                  <summary>ほか{hiddenCategories.length}件を表示</summary>
                  <div class="taxonomy-chips taxonomy-chips-more">
                    {hiddenCategories.map(([name, count]) => (
                      <button type="button" data-filter-kind="category" data-filter-value={name}>{name}<span>{count}</span></button>
                    ))}
                  </div>
                </details>
              )}
            </div>
          )}

          <button class="filter-reset" type="button" data-filter-reset hidden>絞り込みを解除</button>
        </div>
      </details>
    )}

    <div class="article-card-grid" data-article-grid>
      {all.map(article => <ArticleCard article={article} heading="h2" />)}
    </div>
  </section>
</BaseLayout>

<script>
  const cards = Array.from(document.querySelectorAll('[data-article-grid] .article-card'));
  const buttons = Array.from(document.querySelectorAll('[data-filter-kind]'));
  const reset = document.querySelector('[data-filter-reset]');
  const status = document.querySelector('.filter-status');

  let activeKind = '';
  let activeValue = '';

  const applyFilter = () => {
    let visible = 0;
    for (const card of cards) {
      const values = activeKind === 'tag'
        ? JSON.parse(card.getAttribute('data-tags') || '[]')
        : JSON.parse(card.getAttribute('data-categories') || '[]');
      const show = !activeKind || values.includes(activeValue);
      card.hidden = !show;
      if (show) visible += 1;
    }

    for (const button of buttons) {
      const selected = button.getAttribute('data-filter-kind') === activeKind && button.getAttribute('data-filter-value') === activeValue;
      button.classList.toggle('is-active', selected);
      button.setAttribute('aria-pressed', String(selected));
    }

    if (reset) reset.hidden = !activeKind;
    if (status) status.textContent = activeKind ? `${activeValue}：${visible}本` : `${cards.length}本を表示中`;
  };

  for (const button of buttons) {
    button.setAttribute('aria-pressed', 'false');
    button.addEventListener('click', () => {
      const kind = button.getAttribute('data-filter-kind') || '';
      const value = button.getAttribute('data-filter-value') || '';
      if (activeKind === kind && activeValue === value) {
        activeKind = '';
        activeValue = '';
      } else {
        activeKind = kind;
        activeValue = value;
      }
      applyFilter();
    });
  }

  reset?.addEventListener('click', () => {
    activeKind = '';
    activeValue = '';
    applyFilter();
  });
</script>

<style>
  .article-archive{margin-top:clamp(3rem,7vw,5.5rem)}
  .archive-intro{display:flex;gap:1rem;align-items:flex-end;justify-content:space-between;margin:0 0 1.4rem;color:#596273}
  .archive-intro p{margin:0}
  .filter-status{flex:0 0 auto;font-size:.86rem;font-weight:700;color:#666d7b}
  .taxonomy-panel{
    margin:0 0 1.6rem;
    border:1px solid var(--line);
    border-radius:14px;
    background:rgba(255,255,255,.72);
  }
  .taxonomy-panel > summary{
    cursor:pointer;
    padding:.85rem 1rem;
    font-size:.9rem;
    font-weight:750;
    list-style-position:inside;
  }
  .taxonomy-panel[open] > summary{border-bottom:1px solid var(--line)}
  .taxonomy-content{padding:1rem}
  .taxonomy-group + .taxonomy-group{margin-top:1rem;padding-top:1rem;border-top:1px solid #eceef2}
  .taxonomy-title{margin:0 0 .55rem;color:#747b88;font-size:.76rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .taxonomy-chips{display:flex;flex-wrap:wrap;gap:.42rem}
  .taxonomy-chips button,.filter-reset{
    appearance:none;
    border:1px solid #dfe2e8;
    border-radius:999px;
    background:#fff;
    color:#4d5665;
    cursor:pointer;
    font:inherit;
    font-size:.78rem;
    font-weight:650;
  }
  .taxonomy-chips button{padding:.28rem .62rem}
  .taxonomy-chips button span{margin-left:.35rem;color:#9298a3;font-size:.69rem}
  .taxonomy-chips button:hover,.taxonomy-chips button.is-active{border-color:#a7a4df;background:#f1f1ff;color:#38358c}
  .taxonomy-more{margin-top:.65rem}
  .taxonomy-more > summary{cursor:pointer;color:#5f6571;font-size:.78rem;font-weight:700}
  .taxonomy-chips-more{margin-top:.65rem}
  .filter-reset{margin-top:1rem;padding:.34rem .7rem;background:#f8f8fa}
  .article-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}
  .article-card[hidden]{display:none}

  @media(max-width:940px){
    .article-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media(max-width:640px){
    .archive-intro{align-items:flex-start;flex-direction:column}
    .article-card-grid{grid-template-columns:1fr;gap:1rem}
  }
</style>
