---
const { title = 'Copy & Paste Engineer', description = 'Software / AI / OSS / Automation' } = Astro.props;
---
<!doctype html><html lang="ja"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><link rel="icon" href="/favicon.svg" /><title>{title}</title></head><body><header><a class="brand" href="/">Copy & Paste Engineer</a><nav><a href="/projects/">Projects</a><a href="/articles/">Articles</a><a href="/books/">Books</a><a href="/about/">About</a><a href="https://github.com/c-a-p-engineer">GitHub ↗</a></nav></header><main><slot /></main><footer>© {new Date().getFullYear()} Copy & Paste Engineer</footer></body></html><style is:global> :root{font-family:ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif;color:#172033;background:#f7f8fc;line-height:1.7}*{box-sizing:border-box}body{margin:0}header,main,footer{max-width:1120px;margin:auto;padding:1.25rem 1.5rem}header{display:flex;gap:2rem;align-items:center;justify-content:space-between}.brand{font-weight:800;font-size:1.15rem}nav{display:flex;gap:1rem;flex-wrap:wrap}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}main{min-height:80vh}footer{color:#637083;font-size:.9rem}.hero{padding:4rem 0 2rem}.eyebrow{color:#5561c7;font-weight:700}.hero h1{font-size:clamp(2.5rem,7vw,5.8rem);line-height:1.05;margin:.25rem 0 1rem}.lead{font-size:1.25rem;max-width:44rem}.actions{display:flex;gap:.75rem;flex-wrap:wrap;margin:1.5rem 0}.button{background:#252f89;color:white;padding:.65rem 1rem;border-radius:.5rem}.button.ghost{background:white;color:#252f89;border:1px solid #ccd1e6}.section{margin:4rem 0}.section h2{font-size:1.7rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem}.card{background:white;padding:1.25rem;border:1px solid #e0e4ef;border-radius:.75rem}.card h3{margin-top:0}.meta{color:#637083;font-size:.9rem}.tag{display:inline-block;background:#edf0ff;color:#37429f;border-radius:999px;padding:.1rem .55rem;margin:.15rem .15rem 0 0;font-size:.8rem}.article{max-width:780px;margin:auto}.article h1{line-height:1.2;font-size:clamp(2rem,5vw,3.6rem)}.article img{max-width:100%;height:auto}@media(max-width:720px){header{align-items:flex-start;flex-direction:column;gap:.6rem}.hero{padding-top:2rem}}</style>
