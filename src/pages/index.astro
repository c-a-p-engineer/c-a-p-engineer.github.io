---
import BaseLayout from '../layouts/BaseLayout.astro'; import { getCollection } from 'astro:content'; import { articles } from '../lib';
const [projects, books, recent] = [await getCollection('projects'), await getCollection('books'), (await articles()).slice(0,6)];
const isExternal = (href?: string) => Boolean(href?.startsWith('http://') || href?.startsWith('https://'));
---
<BaseLayout><section class="hero"><p class="eyebrow">Software / AI / OSS / Automation</p><h1>作る。試す。<br/>記録する。</h1><p class="lead">Copy & Paste Engineer の活動拠点。つくったものと、試したことの記録です。</p><div class="actions"><a class="button" href="/projects/">Projects</a><a class="button ghost" href="/articles/">Articles</a></div></section><section class="section"><h2>Featured Projects</h2><div class="grid">{projects.filter(p=>p.data.featured).map(p=><a class="card" href={p.data.href}><h3>{p.data.title}</h3><p>{p.data.description}</p>{p.data.tags.map(t=><span class="tag">{t}</span>)}</a>)}</div></section><section class="section"><h2>Latest Articles</h2><div class="grid">{recent.map(a=><a class="card" href={`/${a.data.legacySlug}/`}><p class="meta">{a.data.date.toLocaleDateString('ja-JP')}</p><h3>{a.data.title}</h3><p>{a.data.description}</p></a>)}</div><p><a href="/articles/">すべての記事を見る →</a></p></section><section class="section"><h2>Books & Publishing</h2><div class="grid">{books.map(b=>{const href=b.data.href || '/books/'; const external=isExternal(href); return <a class="card" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}><h3>{b.data.title}</h3><p>{b.data.description}</p></a>})}</div></section></BaseLayout>
